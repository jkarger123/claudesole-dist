#!/usr/bin/env python3
"""cc-agents -- inventory every Claude agent process on this machine, and safely reclaim the abandoned ones.

THE PROBLEM THIS SOLVES (2026-08-07). Agents were accumulating invisibly. `tmux ls` only talks to the ONE
server behind the live socket, but this box had FIVE tmux server generations running: when a tmux server goes
unresponsive ("server exited unexpectedly") a fresh one claims the socket and the old one keeps running with
every session and agent inside it. Nothing anywhere reported that, so one generation from July had been
carrying 22 agents for 23 days. Between them the stranded generations held ~200 of the machine's 511 ptys and
about 70% of a CPU core -- which is why pty pressure idled near the warning line and a browser-terminal leak
had so little room before the whole box seized.

WHY YOU CANNOT JUST KILL WHAT `tmux ls` DOES NOT SHOW. Unreachable does not mean dead. Those generations also
host genuinely live work -- background `claude --resume` agents still writing transcripts, and (in one case)
the text2tune production cron loop. And every idle Claude process burns ~1.4% CPU, so "is it using CPU" does
NOT separate working from abandoned; measured on 51 agents, all 51 were burning CPU and none were dead.

THE SIGNAL THAT ACTUALLY WORKS is the transcript. Each agent writes ONE transcript from launch, so a process
is matched to its transcript by (cwd -> project dir) + (first record timestamp ~= process start time), and its
last write time is real evidence of when it last did anything. An agent is a reclaim candidate only when ALL
of these hold:
  * it is STRANDED   -- no reachable tmux session, so nobody can ever see or use it again, AND
  * it is INACTIVE   -- its transcript has not been written for --idle-hours (default 24), AND
  * it is OURS       -- same user; another user's agents are reported, never signalled, AND
  * it is IDENTIFIED -- we found its transcript. An unmatched process is left ALONE, never killed on a guess.

Usage:
  cc-agents                          full inventory grouped by tmux generation
  cc-agents --stranded               only agents no session can reach
  cc-agents --reclaim                DRY RUN -- exactly what would be killed and why
  cc-agents --reclaim --yes          do it: SIGTERM, batched, re-measured, SIGKILL only for stragglers
  cc-agents --idle-hours 48          require 48h of transcript silence instead of 24
"""
import datetime, glob, json, os, re, signal, subprocess, sys, time

TMUX = os.environ.get("CC_TMUX") or "/opt/homebrew/bin/tmux"
BATCH = 8
PAUSE = 3.0
ME = os.environ.get("USER") or ""


def run(c, timeout=40):
    try:
        return subprocess.run(c, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def procs():
    out = {}
    for l in run(["ps", "-eo", "pid=,ppid=,user=,lstart=,command="]).splitlines():
        f = l.strip().split(None, 3)
        if len(f) < 4:
            continue
        pid, ppid, user, rest = f
        # lstart is 5 whitespace-separated fields ("Fri Aug  7 14:42:43 2026")
        r = rest.split(None, 5)
        if len(r) < 6:
            continue
        lstart = " ".join(r[:5]); cmd = r[5]
        try: st = time.mktime(time.strptime(lstart))
        except Exception: st = 0
        out[pid] = {"ppid": ppid, "user": user, "start": st, "cmd": cmd}
    return out


def live_server():
    """pid of the tmux server behind the reachable socket -- the ONLY generation `tmux ls` can see."""
    env = dict(os.environ, TMUX_TMPDIR="/tmp"); env.pop("TMUX", None)
    try:
        return subprocess.run([TMUX, "display-message", "-p", "#{pid}"], capture_output=True, text=True,
                              timeout=15, env=env).stdout.strip()
    except Exception:
        return ""


def panes():
    env = dict(os.environ, TMUX_TMPDIR="/tmp"); env.pop("TMUX", None)
    m = {}
    try:
        o = subprocess.run([TMUX, "list-panes", "-a", "-F", "#{session_name} #{pane_pid}"],
                           capture_output=True, text=True, timeout=20, env=env).stdout
        for l in o.splitlines():
            p = l.split()
            if len(p) == 2: m[p[1]] = p[0]
    except Exception: pass
    return m


def cwd_of(pid):
    o = run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"], timeout=20)
    return "".join(x[1:] for x in o.splitlines() if x.startswith("n"))


def transcript_for(cwd, start, cmd):
    """(path, last_write) for this agent's transcript, or (None, 0).

    Two ways in. An explicit `--resume <uuid>` names the file outright. Otherwise: each agent writes ONE
    transcript from launch, so within the cwd's project dir the right file is the one whose FIRST record was
    written when this process started. Newest-mtime is the tempting shortcut and it is WRONG -- several
    long-lived agents share a cwd, and newest-mtime picks whichever one is busiest, not yours."""
    m = re.search(r"--resume\s+([0-9a-f-]{36})", cmd or "")
    if m:
        for f in glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % m.group(1))):
            return f, os.path.getmtime(f)
    if not cwd or not start:
        return None, 0
    d = os.path.expanduser("~/.claude/projects/" + cwd.replace("/", "-"))
    if not os.path.isdir(d):
        return None, 0
    best = None
    for f in glob.glob(d + "/*.jsonl"):
        t = _first_ts(f)
        if t and (best is None or abs(t - start) < abs(best[0] - start)): best = (t, f)
    if best and abs(best[0] - start) <= 300:          # confident match only
        return best[1], os.path.getmtime(best[1])
    return None, 0


def _first_ts(path, scan=60):
    """Timestamp of the transcript's first REAL record.

    Not simply the first line: a compacted transcript begins with a `summary` record that carries no
    `timestamp`, and bailing on that line silently discards the whole file -- which made the matcher fail for
    47 of 51 agents while appearing to work on the one uncompacted session I first tested it against. Scan
    forward until a timestamped record appears."""
    try:
        with open(path, errors="replace") as fh:
            for i, line in enumerate(fh):
                if i >= scan: break
                try: ts = (json.loads(line) or {}).get("timestamp")
                except Exception: continue
                if ts:
                    return datetime.datetime.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S").replace(
                        tzinfo=datetime.timezone.utc).timestamp()
    except Exception: pass
    return 0


def inventory():
    P = procs(); pn = panes(); ls = live_server()
    def sess(pid):
        cur = pid
        for _ in range(14):
            if cur in pn: return pn[cur]
            cur = P.get(cur, {}).get("ppid", "0")
            if cur in ("0", "1", ""): return None
        return None
    def gen(pid):
        cur = pid
        for _ in range(14):
            nxt = P.get(cur, {}).get("ppid", "0")
            if nxt in ("0", "1", ""): return cur
            if "tmux" in P.get(nxt, {}).get("cmd", ""): return nxt
            cur = nxt
        return cur
    rows = []
    for pid, v in P.items():
        if os.path.basename((v["cmd"].split() or [""])[0]) != "claude":
            continue
        cwd = cwd_of(pid) if v["user"] == ME else ""
        tx, last = transcript_for(cwd, v["start"], v["cmd"]) if cwd else (None, 0)
        rows.append({"pid": pid, "user": v["user"], "start": v["start"], "cwd": cwd,
                     "sess": sess(pid), "gen": gen(pid), "tx": tx, "last": last,
                     "live_gen": ls})
    return rows, ls


def fmt_age(s):
    if not s: return "?"
    d = time.time() - s
    return ("%dd%02dh" % (d // 86400, (d % 86400) // 3600)) if d >= 86400 else ("%dh%02dm" % (d // 3600, (d % 3600) // 60))


def main(argv):
    idle_h = 24
    if "--idle-hours" in argv:
        i = argv.index("--idle-hours")
        if i + 1 < len(argv):
            try: idle_h = float(argv[i + 1])
            except Exception: pass
    rows, ls = inventory()
    stranded = [r for r in rows if not r["sess"]]
    print("Claude agents: %d total | %d reachable | %d STRANDED (no session can reach them)"
          % (len(rows), len(rows) - len(stranded), len(stranded)))
    print("live tmux generation: %s\n" % (ls or "?"))

    gens = {}
    for r in rows: gens.setdefault(r["gen"], []).append(r)
    P = procs()
    print("%-9s %-9s %-7s %-8s %s" % ("TMUX GEN", "STATE", "AGENTS", "STARTED", "note"))
    for g, rs in sorted(gens.items(), key=lambda kv: -len(kv[1])):
        state = "LIVE" if g == ls else "STRANDED"
        st = P.get(g, {}).get("start", 0)
        note = "" if g == ls else "invisible to `tmux ls` -- nothing reports it"
        print("%-9s %-9s %-7d %-8s %s" % (g, state, len(rs), fmt_age(st), note))

    show = stranded if ("--stranded" in argv or "--reclaim" in argv) else rows
    if "--reclaim" not in argv:
        print("\n%-8s %-11s %-8s %-24s %-9s %s" % ("PID", "OWNER", "AGE", "SESSION", "LAST ACT", "CWD"))
        for r in sorted(show, key=lambda r: r["start"]):
            la = ("%.1fh ago" % ((time.time() - r["last"]) / 3600)) if r["last"] else "unknown"
            print("%-8s %-11s %-8s %-24s %-9s %s" % (r["pid"], r["user"], fmt_age(r["start"]),
                                                     r["sess"] or "-- stranded --", la, (r["cwd"] or "?")[:46]))
        print("\n(--reclaim shows what could be safely reclaimed; it is a DRY RUN unless you add --yes)")
        return 0

    cutoff = time.time() - idle_h * 3600
    cand, spared = [], []
    for r in stranded:
        if r["user"] != ME: spared.append((r, "another user -- reported only, never signalled")); continue
        if not r["tx"]:     spared.append((r, "no transcript matched -- NOT killed on a guess")); continue
        if r["last"] > cutoff:
            spared.append((r, "active %.1fh ago (< %gh)" % ((time.time() - r["last"]) / 3600, idle_h))); continue
        cand.append(r)
    print("\nRECLAIM CANDIDATES (stranded AND silent for %gh AND identified): %d" % (idle_h, len(cand)))
    for r in sorted(cand, key=lambda r: r["last"]):
        print("   pid %-8s age %-8s silent %5.1fh   %s" % (r["pid"], fmt_age(r["start"]),
              (time.time() - r["last"]) / 3600, os.path.basename(r["tx"])[:40]))
    print("\nSPARED: %d" % len(spared))
    seen = {}
    for r, why in spared: seen[why] = seen.get(why, 0) + 1
    for why, n in sorted(seen.items(), key=lambda kv: -kv[1]): print("   %3d  %s" % (n, why))

    if "--yes" not in argv:
        print("\nDRY RUN -- nothing was signalled. Re-run with --yes to reclaim the candidates above.")
        print("Their transcripts stay on disk and remain resumable from the History lens.")
        return 0
    if not cand:
        print("\nnothing to reclaim"); return 0
    print("\nreclaiming %d agent(s), batches of %d, SIGTERM first" % (len(cand), BATCH))
    for i in range(0, len(cand), BATCH):
        for r in cand[i:i + BATCH]:
            try: os.kill(int(r["pid"]), signal.SIGTERM)
            except Exception: pass
        time.sleep(PAUSE)
        print("  batch %d: %d signalled" % (i // BATCH + 1, len(cand[i:i + BATCH])))
    time.sleep(4)
    left = []
    for r in cand:
        try: os.kill(int(r["pid"]), 0); left.append(r)
        except Exception: pass
    if left:
        print("  %d ignored SIGTERM -> SIGKILL" % len(left))
        for r in left:
            try: os.kill(int(r["pid"]), signal.SIGKILL)
            except Exception: pass
    time.sleep(2)
    rows2, _ = inventory()
    print("\nagents now: %d (was %d).  pty devices: %d/511"
          % (len(rows2), len(rows), len([n for n in os.listdir("/dev") if n.startswith("ttys")])))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
